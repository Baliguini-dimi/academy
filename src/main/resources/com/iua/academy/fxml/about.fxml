<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="content-area" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.iua.academy.controller.AboutController">
    <VBox spacing="24" maxWidth="640">

        <VBox spacing="4">
            <Label text="A propos" styleClass="page-title" />
            <Label text="Informations sur l'application" styleClass="page-subtitle" />
        </VBox>

        <!-- ===== Bloc principal : l'application ===== -->
        <VBox styleClass="card" spacing="10">
            <HBox alignment="BASELINE_LEFT" spacing="10">
                <Label text="ACADEMY" styleClass="about-hero-title" />
                <Label text="v1.0.0" styleClass="about-version-badge" />
            </HBox>
            <Label text="Gestion academique" styleClass="about-hero-subtitle" />

            <Region prefHeight="8" />

            <Label text="A PROPOS D'ACADEMY" styleClass="section-label" />
            <Label text="ACADEMY est une solution desktop concue pour simplifier la gestion academique : gestion des etudiants, gestion des matieres, saisie et suivi des notes, statistiques et suivi des performances, generation de bulletins."
                   wrapText="true" styleClass="about-description" />
        </VBox>

        <!-- ===== Bloc secondaire : conception ===== -->
        <VBox styleClass="card-secondary" spacing="12">
            <Label text="CONCEPTION ET DEVELOPPEMENT" styleClass="section-label" />

            <VBox spacing="2">
                <Label text="Dimitri Nelson BALIGUINI" styleClass="about-name-secondary" />
                <Label text="Developpeur Full-Stack" styleClass="about-role-secondary" />
            </VBox>

            <HBox spacing="10">
                <Button text="Email" styleClass="btn-action-neutral" onAction="#ouvrirEmail" />
                <Button text="GitHub" styleClass="btn-action-neutral" onAction="#ouvrirGithub" />
                <Button text="LinkedIn" styleClass="btn-action-neutral" onAction="#ouvrirLinkedin" />
            </HBox>

            <VBox styleClass="about-quote-box">
                <Label text="ACADEMY est ne d'une volonte simple : concevoir un outil academique fiable, clair et accessible, pense autour des besoins reels de ceux qui gerent et suivent les parcours etudiants. Concu et developpe par Dimitri Nelson BALIGUINI, developpeur Full-Stack, ACADEMY privilegie une approche simple : transformer des taches administratives quotidiennes en une experience de gestion plus fluide, structuree et efficace."
                       wrapText="true" styleClass="about-quote-text" textAlignment="CENTER" />
            </VBox>
        </VBox>

        <Label text="Java 17  -  JavaFX 21  -  SQLite" styleClass="about-tech-discrete" />

        <padding>
            <Insets top="0" right="4" bottom="30" left="0" />
        </padding>

    </VBox>
</ScrollPane>