<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.iua.academy.controller.NotesController">

    <VBox spacing="4">
        <Label text="Notes" styleClass="page-title" />
        <Label text="Saisie et suivi des resultats academiques" styleClass="page-subtitle" />
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="champRecherche" promptText="Rechercher : etudiant ou matiere..." prefWidth="220" />
        <ComboBox fx:id="comboFiltreEtudiant" promptText="Tous les etudiants" prefWidth="160" />
        <ComboBox fx:id="comboFiltreMatiere" promptText="Toutes les matieres" prefWidth="150" />
        <ComboBox fx:id="comboFiltreType" promptText="Tous les types" prefWidth="130" />
        <ComboBox fx:id="comboFiltrePeriode" promptText="Toutes les dates" prefWidth="140" />
        <Button text="Rechercher" styleClass="btn-action-primary" onAction="#rechercher" minWidth="-Infinity" />
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnModifier" text="Modifier" styleClass="btn-action-primary" onAction="#ouvrirFormulaireModification" minWidth="-Infinity" />
        <Button fx:id="btnSupprimer" text="Supprimer" styleClass="btn-action-danger" onAction="#supprimerSelection" minWidth="-Infinity" />

        <Region HBox.hgrow="ALWAYS" />

        <Button text="+ Nouvelle note" styleClass="btn-action-create" onAction="#ouvrirFormulaireAjout" minWidth="-Infinity">
            <graphic>
                <FontIcon iconLiteral="mdi2p-plus" iconSize="14" iconColor="WHITE" />
            </graphic>
        </Button>
    </HBox>

    <Label fx:id="lblIndicationSelection" text="Selectionnez une note dans la liste pour la Modifier ou la Supprimer."
           styleClass="page-subtitle" />

    <TableView fx:id="tableNotes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colEtudiant" text="Etudiant" prefWidth="170" />
            <TableColumn fx:id="colMatiere" text="Matiere" prefWidth="140" />
            <TableColumn fx:id="colValeur" text="Note /20" prefWidth="80" />
            <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="110" />
            <TableColumn fx:id="colType" text="Type" prefWidth="110" />
            <TableColumn fx:id="colDate" text="Date" prefWidth="100" />
        </columns>
    </TableView>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0" />
    </padding>

</VBox>