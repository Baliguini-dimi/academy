<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="20" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.iua.academy.controller.NotesController">

    <VBox spacing="4">
        <Label text="Notes" styleClass="page-title" />
        <Label text="Saisie et suivi des notes" styleClass="page-subtitle" />
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="champRecherche" promptText="Rechercher : etudiant ou matiere..." prefWidth="280" />
        <Button text="Rechercher" styleClass="btn-action-primary" onAction="#rechercher" minWidth="-Infinity" />

        <Region HBox.hgrow="ALWAYS" />

        <Button text="Modifier" styleClass="btn-action-primary" onAction="#ouvrirFormulaireModification" minWidth="-Infinity" />
        <Button text="Supprimer" styleClass="btn-action-danger" onAction="#supprimerSelection" minWidth="-Infinity" />
        <Button text="+ Nouvelle note" styleClass="btn-action-create" onAction="#ouvrirFormulaireAjout" minWidth="-Infinity">
            <graphic>
                <FontIcon iconLiteral="mdi2p-plus" iconSize="14" iconColor="WHITE" />
            </graphic>
        </Button>
    </HBox>

    <TableView fx:id="tableNotes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colEtudiant" text="Etudiant" prefWidth="180" />
            <TableColumn fx:id="colMatiere" text="Matiere" prefWidth="150" />
            <TableColumn fx:id="colValeur" text="Note /20" prefWidth="90" />
            <TableColumn fx:id="colType" text="Type" prefWidth="120" />
            <TableColumn fx:id="colDate" text="Date" prefWidth="110" />
        </columns>
    </TableView>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0" />
    </padding>

</VBox>
