<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="card" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.iua.academy.controller.EtudiantFormController">

    <Label text="Fiche etudiant" styleClass="page-title" />

    <!-- ===== Informations personnelles ===== -->
    <VBox spacing="10">
        <Label text="INFORMATIONS PERSONNELLES" styleClass="section-label" />

        <GridPane hgap="12" vgap="6">
            <columnConstraints>
                <ColumnConstraints minWidth="130" />
                <ColumnConstraints minWidth="240" />
            </columnConstraints>

            <Label text="Matricule *" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <VBox spacing="2" GridPane.rowIndex="0" GridPane.columnIndex="1">
                <TextField fx:id="champMatricule" />
                <Label fx:id="lblErreurMatricule" styleClass="feedback-error" visible="false" managed="false" />
            </VBox>

            <Label text="Nom *" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <VBox spacing="2" GridPane.rowIndex="1" GridPane.columnIndex="1">
                <TextField fx:id="champNom" />
                <Label fx:id="lblErreurNom" styleClass="feedback-error" visible="false" managed="false" />
            </VBox>

            <Label text="Prenom *" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <VBox spacing="2" GridPane.rowIndex="2" GridPane.columnIndex="1">
                <TextField fx:id="champPrenom" />
                <Label fx:id="lblErreurPrenom" styleClass="feedback-error" visible="false" managed="false" />
            </VBox>

            <Label text="Date de naissance" GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <DatePicker fx:id="champDateNaissance" GridPane.rowIndex="3" GridPane.columnIndex="1" />

            <Label text="Email" GridPane.rowIndex="4" GridPane.columnIndex="0" />
            <TextField fx:id="champEmail" GridPane.rowIndex="4" GridPane.columnIndex="1" />
        </GridPane>
    </VBox>

    <!-- ===== Informations academiques ===== -->
    <VBox spacing="10">
        <Label text="INFORMATIONS ACADEMIQUES" styleClass="section-label" />

        <GridPane hgap="12" vgap="6">
            <columnConstraints>
                <ColumnConstraints minWidth="130" />
                <ColumnConstraints minWidth="240" />
            </columnConstraints>

            <Label text="Classe *" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <VBox spacing="2" GridPane.rowIndex="0" GridPane.columnIndex="1">
                <TextField fx:id="champClasse" />
                <Label fx:id="lblErreurClasse" styleClass="feedback-error" visible="false" managed="false" />
            </VBox>
        </GridPane>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" styleClass="btn-action-neutral" onAction="#annuler" />
        <Button text="Enregistrer" styleClass="btn-action-primary" onAction="#enregistrer" />
    </HBox>

    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>

</VBox>