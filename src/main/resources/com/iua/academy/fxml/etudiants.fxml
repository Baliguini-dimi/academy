<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="20" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.iua.academy.controller.EtudiantsController">

    <VBox spacing="4">
        <Label text="Etudiants" styleClass="page-title" />
        <Label text="Gestion des fiches etudiantes" styleClass="page-subtitle" />
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="champRecherche" promptText="Rechercher un etudiant : nom, prenom, matricule..." prefWidth="320" />
        <ComboBox fx:id="comboFiltreClasse" promptText="Toutes les classes" prefWidth="160" />
        <Button text="Rechercher" styleClass="btn-action-primary" onAction="#rechercher" />

        <Region HBox.hgrow="ALWAYS" />

        <Button text="Modifier" styleClass="btn-action-primary" onAction="#ouvrirFormulaireModification" />
        <Button text="Bulletin PDF" styleClass="btn-action-neutral" onAction="#exporterBulletin" />
        <Button text="Supprimer" styleClass="btn-action-danger" onAction="#supprimerSelection" />
        <Button text="+ Nouvel etudiant" styleClass="btn-action-create" onAction="#ouvrirFormulaireAjout">
            <graphic>
                <FontIcon iconLiteral="mdi2p-plus" iconSize="14" iconColor="WHITE" />
            </graphic>
        </Button>
    </HBox>

    <TableView fx:id="tableEtudiants" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colMatricule" text="Matricule" prefWidth="110" />
            <TableColumn fx:id="colNom" text="Nom" prefWidth="140" />
            <TableColumn fx:id="colPrenom" text="Prenom" prefWidth="140" />
            <TableColumn fx:id="colClasse" text="Classe" prefWidth="110" />
            <TableColumn fx:id="colEmail" text="Email" prefWidth="180" />
            <TableColumn fx:id="colMoyenne" text="Moyenne" prefWidth="90" />
        </columns>
    </TableView>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0" />
    </padding>

</VBox>